# ═══════════════════════════════════════
# ARHIA — Environment Variables Example
# Copiar a .env y completar los valores
# ═══════════════════════════════════════

# ─── App ───────────────────────────────
NODE_ENV=development
APP_NAME=ARHIA
APP_URL=http://localhost:5173
API_URL=http://localhost:3001

# ─── Ports ─────────────────────────────
WEB_PORT=5173
API_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379

# ─── PostgreSQL ─────────────────────────
POSTGRES_USER=arhia
POSTGRES_PASSWORD=arhia_dev_password
POSTGRES_DB=arhia_db
DATABASE_URL=postgresql://arhia:arhia_dev_password@localhost:5432/arhia_db?schema=public

# ─── Redis ──────────────────────────────
REDIS_PASSWORD=arhia_redis_password
REDIS_URL=redis://:arhia_redis_password@localhost:6379

# ─── JWT ────────────────────────────────
# Generar con: openssl rand -base64 64
JWT_ACCESS_SECRET=change_me_in_production_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_in_production_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Anthropic / Claude ─────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=4096

# ─── AWS S3 ─────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=arhia-files-dev

# ─── Integrations ───────────────────────
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# WhatsApp Business (Meta)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=

# DocuSign
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_CLIENT_SECRET=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_REDIRECT_URI=http://localhost:3001/integrations/docusign/callback

# Biometrik Pro
BIOMETRIK_API_URL=
BIOMETRIK_API_KEY=

# Salesforce
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=http://localhost:3001/integrations/salesforce/callback

# AFIP WebServices
AFIP_CUIT=
AFIP_CERT_PATH=./certs/afip.crt
AFIP_KEY_PATH=./certs/afip.key
AFIP_ENVIRONMENT=testing

# TuRecibo.com
TURECIBO_API_KEY=
TURECIBO_API_URL=

# ─── Email (SMTP) ───────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@arhia.ai

# ─── Rate Limiting ──────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
CHAT_RATE_LIMIT_MAX=20

# ─── Logging ────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=pretty

# ─── Frontend (Vite) ────────────────────
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001
VITE_APP_NAME=ARHIA
