{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@arhia/shared": ["../../packages/shared/src"],
      "@arhia/ui": ["../../packages/ui/src"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
