#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Enforce conventional commits: type(scope): message
commit_msg=$(cat "$1")
pattern="^(feat|fix|docs|style|refactor|perf|test|chore|ci|build|revert)(\(.+\))?: .{1,72}"

if ! echo "$commit_msg" | grep -qE "$pattern"; then
  echo "❌ Commit message format inválido."
  echo "   Formato: type(scope): descripción"
  echo "   Tipos válidos: feat, fix, docs, style, refactor, perf, test, chore, ci, build, revert"
  echo "   Ejemplo: feat(employees): agregar filtro por departamento"
  exit 1
fi
